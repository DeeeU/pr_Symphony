{% extends 'base.html.twig' %}

{% block title %}タイムライン{% endblock %}

{% block stylesheets %}
<style>
    .timeline {
        position: relative;
        padding: 20px 0;
    }

    .timeline-date {
        background: #007bff;
        color: white;
        padding: 10px 20px;
        border-radius: 20px;
        display: inline-block;
        margin: 20px 0 10px 0;
        font-weight: bold;
    }

    .timeline-item {
        position: relative;
        padding-left: 40px;
        margin-bottom: 30px;
        border-left: 3px solid #e9ecef;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -8px;
        top: 0;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #007bff;
        border: 3px solid white;
        box-shadow: 0 0 0 2px #007bff;
    }

    .timeline-card {
        border-left: 4px solid #007bff;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .timeline-card:hover {
        transform: translateX(5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .timeline-time {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .timeline-author {
        color: #495057;
        font-size: 0.85rem;
        font-style: italic;
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
            <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z"/>
            <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z"/>
            <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z"/>
        </svg>
        タイムライン
    </h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="alert alert-info mb-4">
        全 {{ pagination.getTotalItemCount }} 件のメモ
    </div>

    {% if pagination|length > 0 %}
        <div class="timeline">
            {% set currentDate = null %}
            {% for memo in pagination %}
                {% set memoDate = memo.createdAt|date('Y-m-d') %}

                {# 日付が変わったら日付ヘッダーを表示 #}
                {% if currentDate != memoDate %}
                    {% set currentDate = memoDate %}
                    <div class="timeline-date">
                        📅 {{ memo.createdAt|date('Y年m月d日 (D)', 'Asia/Tokyo') }}
                    </div>
                {% endif %}

                <div class="timeline-item">
                    <div class="card timeline-card mb-3" {% if memo.category %}style="border-left-color: {{ memo.category.color }}"{% endif %}>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">{{ memo.title }}</h5>
                                <div>
                                    {% if memo.category %}
                                        <span class="badge" style="background-color: {{ memo.category.color }}">
                                            {{ memo.category.name }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if memo.tags|length > 0 %}
                                <div class="mb-2">
                                    {% for tag in memo.tags %}
                                        <span class="badge badge-secondary" style="background-color: {{ tag.color }}">
                                            🏷️ {{ tag.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <p class="card-text text-muted">
                                {% if memo.content|length > 100 %}
                                    {{ memo.content|slice(0, 100) }}...
                                {% else %}
                                    {{ memo.content }}
                                {% endif %}
                            </p>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="timeline-time">
                                        🕐 {{ memo.createdAt|date('H:i') }}
                                    </span>
                                    {% if memo.author %}
                                        <span class="timeline-author ml-3">
                                            👤 {{ memo.author.name }}
                                        </span>
                                    {% endif %}
                                </div>
                                <div>
                                    <a href="{{ path('memo_show', {'id': memo.id}) }}" class="btn btn-sm btn-outline-primary">詳細</a>
                                    <a href="{{ path('memo_edit', {'id': memo.id}) }}" class="btn btn-sm btn-outline-warning">編集</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="navigation mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="alert alert-info">
            まだメモがありません。<a href="{{ path('memo_new') }}">最初のメモを作成</a>してみましょう！
        </div>
    {% endif %}
</div>
{% endblock %}
