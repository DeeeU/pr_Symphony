{% extends 'base.html.twig' %}

{% block title %}メモコンテナ一覧{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fas fa-boxes"></i> メモコンテナ一覧</h2>
            <p class="text-muted">ユーザー別にメモをまとめて表示します</p>
            <hr>

            {% if users|length == 0 %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> メモを作成したユーザーがいません。
                </div>
            {% else %}
                <div class="row">
                    {% for user in users %}
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">{{ user.name }}</h5>
                                    <p class="card-text">{{ user.email }}</p>
                                    <a href="{{ path('memo_container_user_summary', {'userId': user.id}) }}"
                                       class="btn btn-primary">
                                        <i class="fas fa-box"></i> メモまとめを見る
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
