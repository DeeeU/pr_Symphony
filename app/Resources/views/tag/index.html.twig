{% extends 'base.html.twig' %}

{% block title %}タグ一覧{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>🏷️ タグ一覧</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">タグ検索</h5>
            <form method="GET" action="{{ path('tag_index') }}">
                <div class="row">
                    <div class="col-md-8">
                        <input type="text" class="form-control" name="keyword"
                               value="{{ keyword }}" placeholder="タグ名で検索">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">検索</button>
                        <a href="{{ path('tag_index') }}" class="btn btn-secondary">クリア</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <a href="{{ path('tag_new') }}" class="btn btn-success mb-3">➕ 新規タグ作成</a>

    <div class="alert alert-info">
        全 {{ pagination.getTotalItemCount }} 件のタグ
    </div>

    {% if pagination|length > 0 %}
        <div class="row">
            {% for tag in pagination %}
                <div class="col-md-4 mb-3">
                    <div class="card" style="border-left: 4px solid {{ tag.color }}">
                        <div class="card-body">
                            <h5 class="card-title">
                                <span class="badge" style="background-color: {{ tag.color }}">
                                    {{ tag.name }}
                                </span>
                            </h5>
                            <p class="text-muted small">
                                📊 {{ tag.memoCount }} 件のメモ<br>
                                📅 作成日: {{ tag.createdAt|date('Y-m-d') }}
                            </p>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('tag_edit', {'id': tag.id}) }}"
                                   class="btn btn-warning">編集</a>
                            </div>
                            <form method="POST" action="{{ path('tag_delete', {'id': tag.id}) }}"
                                  style="display: inline;"
                                  onsubmit="return confirm('タグ「{{ tag.name }}」を削除しますか？')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">削除</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="navigation mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="alert alert-info">
            {% if keyword %}
                検索条件に一致するタグが見つかりませんでした。
            {% else %}
                まだタグがありません。<a href="{{ path('tag_new') }}">最初のタグを作成</a>してみましょう！
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
